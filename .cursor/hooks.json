{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-prod-push.sh",
        "matcher": "git\\s+(push|merge)",
        "timeout": 15,
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/protect-env.sh",
        "matcher": "\\.env",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/protect-env.sh",
        "matcher": "Write|Edit",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/warn-sensitive-paths.sh",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/warn-sensitive-paths.sh",
        "matcher": "git\\s+commit",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-continue-todos.sh",
        "loop_limit": 5,
        "timeout": 20
      }
    ]
  }
}
